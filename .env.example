# ==========================================
# Настройки Telegram-бота
# ==========================================
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ==========================================
# Настройки LLM (Искусственного Интеллекта)
# ==========================================
# Провайдер: gemini (бесплатно) или openai
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Опционально: OpenAI
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
WHISPER_MODEL=whisper-1
# OPENAI_BASE_URL=https://api.openai.com/v1

# ==========================================
# Интеграция с Google Sheets
# ==========================================
# Вариант 1 (Рекомендуемый): Google Apps Script Webhook
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/.../exec

# Вариант 2: Прямой доступ через Service Account (service_account.json)
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# Общие реквизиты таблицы
GOOGLE_SPREADSHEET_ID=your_google_spreadsheet_id_here
GOOGLE_WORKSHEET_NAME=Лист1
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/your_google_spreadsheet_id_here/edit

# ==========================================
# Интеграция с Битрикс24 (REST API / Вебхук)
# ==========================================
BITRIX24_WEBHOOK_URL=https://your-portal.bitrix24.ru/rest/1/webhook_token/
BITRIX24_RESPONSIBLE_ID=1
BITRIX24_CREATE_TASK=true
BITRIX24_CREATE_FEED_POST=true

# ==========================================
# Локальный резерв (Fallback)
# ==========================================
LOCAL_EXCEL_PATH=Ежедневное_выполнение_Садик.xlsx
ALLOW_MOCK_FALLBACK=true
